# Live guide generation needs ONE of these (server-side only, never exposed to the browser).
# Free option: Google Gemini API key from https://aistudio.google.com/apikey (free tier includes Google Search grounding).
GEMINI_API_KEY=
# Paid alternative: OpenAI (Responses API + web_search)
# OPENAI_API_KEY=

# Optional but recommended for deployments: free Tavily search key (https://app.tavily.com, 1,000 searches/month, no card).
# Without it the Gemini agent uses DuckDuckGo's keyless endpoint, which throttles bursts and may block cloud IPs;
# the agent then falls back to reading the provider's known documentation pages directly.
# TAVILY_API_KEY=

# Optional: force a provider when both keys are set ("gemini" or "openai")
# LLM_PROVIDER=gemini
# Optional: use Gemini's Google Search grounding instead of agent search (needs a project with grounding quota)
# GEMINI_GROUNDING=1

# Optional model overrides. By default the newest available Gemini Flash / Flash-Lite models are picked automatically.
# GEMINI_MODEL=
# GEMINI_FAST_MODEL=
# OPENAI_MODEL=gpt-5.4
# OPENAI_FAST_MODEL=gpt-5.4-mini

# Optional: persist generated guides in Vercel Blob (set automatically when you connect a Blob store on Vercel).
# Without it, guides are written to ./.data locally (or /tmp on Vercel, which is not durable).
# BLOB_READ_WRITE_TOKEN=

# Optional: live generations allowed per IP per hour (per server instance)
# GENERATE_LIMIT_PER_HOUR=12
